{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node10",
        "ignoreDeprecations": "6.0",
        "rootDir": "../../packages/GameFramework",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "preserveConstEnums": true
    },
    "include": ["../../packages/GameFramework/**/*.ts"],
    "exclude": ["../../packages/GameFramework/node_modules"]
}
